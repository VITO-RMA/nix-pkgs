diff --git a/cmake/ProjUtilities.cmake b/cmake/ProjUtilities.cmake
--- a/cmake/ProjUtilities.cmake
+++ b/cmake/ProjUtilities.cmake
@@ -55,6 +55,11 @@ function(configure_proj_pc)
   set(datadir "$\{datarootdir\}")
   set(PACKAGE "proj")
   set(VERSION ${PROJ_VERSION})
+  if(MINGW)
+    # Both static and DLL import archives use this name, not the DLL name.
+    get_target_property(PROJ_OUTPUT_NAME proj ARCHIVE_OUTPUT_NAME)
+  endif()
+
   # Build strings of dependencies (Libs.private, Requires.private)
   set(EXTRA_LIBS "${CMAKE_THREAD_LIBS_INIT}")
   set(EXTRA_REQUIRES "")
@@ -79,6 +84,14 @@ function(configure_proj_pc)
     set(cxx_libs "${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES}")
     list(REMOVE_ITEM cxx_libs ${CMAKE_C_IMPLICIT_LINK_LIBRARIES} nonempty)
     foreach(lib IN LISTS cxx_libs)
+      # MinGW can report an absolute libstdc++.a, while Zig builds its
+      # implicit runtimes in a temporary cache. Let the consumer's compiler
+      # find these libraries rather than prefixing an archive path with -l.
+      if(IS_ABSOLUTE "${lib}" AND (MINGW OR lib MATCHES "/zig-cache/"))
+        get_filename_component(lib "${lib}" NAME_WE)
+        string(REGEX REPLACE "^lib" "" lib "${lib}")
+      endif()
+
       list(APPEND EXTRA_LIBS "-l${lib}")
     endforeach()
   endif()
